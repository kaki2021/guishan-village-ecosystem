# 仅供本地部署脚本读取；复制为 .env 后填写真实值。
WECHAT_CLI_PATH=/absolute/path/to/wechat-devtools-cli
WECHAT_CLOUD_ENV_ID=your-cloud-environment-id
PROJECT_PATH=/absolute/path/to/guishan-village-ecosystem

# 下列变量需分别配置到使用它们的微信云函数环境中，根目录 .env 不会自动同步到云端。
ARK_API_KEY=your-ark-api-key
ARK_MODEL=your-ark-model-or-endpoint-id
ARK_VISION_MODEL=your-ark-vision-model-or-endpoint-id
SUBSCRIBE_TEMPLATE_ID=your-wechat-subscribe-template-id
