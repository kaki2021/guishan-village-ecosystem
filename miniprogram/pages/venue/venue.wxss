.vhero { color:#fff; padding:60rpx 40rpx 50rpx; }
.vh-name { font-size:60rpx; letter-spacing:6rpx; }
.vh-intro { margin-top:16rpx; opacity:.92; }
.vh-addr { margin-top:10rpx; font-size:24rpx; opacity:.8; }
.row { display:flex; align-items:center; background:#fffdf8; border:1rpx solid #e6ddcf; border-radius:16rpx; padding:20rpx; margin-bottom:20rpx; }
.r-cover { width:140rpx; height:140rpx; border-radius:12rpx; background:#ece6da; margin-right:24rpx; flex-shrink:0; }
.r-title { font-size:32rpx; margin-bottom:12rpx; }
.v-cover { width:100%; display:block; }
.vh-type { display:inline-block; font-size:24rpx; background:rgba(255,255,255,.25); color:#fff; border-radius:24rpx; padding:6rpx 22rpx; margin-bottom:16rpx; }
.detail { margin-bottom:10rpx; }
.d-p { font-size:30rpx; line-height:1.9; color:#3a3a36; margin-bottom:18rpx; }
.d-img { width:100%; border-radius:12rpx; margin-bottom:18rpx; display:block; }

/* 节点背景音乐按钮 */
.vh-music { display: inline-block; margin-top: 20rpx; padding: 12rpx 28rpx; font-size: 24rpx; color: #fff; border: 1rpx solid rgba(255,255,255,.5); border-radius: 30rpx; }
