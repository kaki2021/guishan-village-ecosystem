.container { padding: 28rpx 32rpx 100rpx; }
.muted { color: #8a8378; }
.ppick { background: #fffdf8; border: 1rpx solid #e6ddcf; border-radius: 12rpx; padding: 26rpx; font-size: 30rpx; color: #8a8378; }
.pp-name { color: #2f2f2b; font-weight: 600; }
.grp { font-size: 28rpx; font-weight: 600; color: #41523f; margin: 40rpx 0 18rpx; }
.f { margin-bottom: 24rpx; }
.lb { font-size: 25rpx; color: #8a8378; margin-bottom: 14rpx; }
.ipt, .ta { background: #fffdf8; border: 1rpx solid #e6ddcf; border-radius: 12rpx; padding: 22rpx 24rpx; font-size: 30rpx; line-height: 1.6; width: 100%; box-sizing: border-box; }
.ta { min-height: 96rpx; }
.ta.html { min-height: 460rpx; font-family: "Courier New", monospace; font-size: 26rpx; line-height: 1.65; }
.cover-wrap { position: relative; width: 100%; height: 320rpx; border-radius: 14rpx; overflow: hidden; }
.cover-img { width: 100%; height: 100%; }
.cover-del { position: absolute; top: 12rpx; right: 12rpx; width: 48rpx; height: 48rpx; line-height: 44rpx; text-align: center; background: rgba(0,0,0,.5); color: #fff; border-radius: 50%; font-size: 36rpx; }
.cover-add { background: #fffdf8; border: 1rpx dashed #c2b8a6; border-radius: 14rpx; padding: 50rpx; text-align: center; color: #8a8378; font-size: 28rpx; }
.hint { font-size: 24rpx; line-height: 1.75; color: #8a7c63; background: #f6efe6; border-radius: 12rpx; padding: 24rpx; margin-bottom: 18rpx; }
.hl { color: #9c5a3c; }
.row { display: flex; margin-top: 18rpx; }
.mini-btn { flex: 1; text-align: center; color: #5f7060; background: #eef1ea; border-radius: 12rpx; padding: 22rpx; font-size: 28rpx; margin-right: 16rpx; }
.mini-btn:last-child { margin-right: 0; }
.preview { margin-top: 28rpx; background: #fffdf8; border: 1rpx solid #e6ddcf; border-radius: 14rpx; padding: 28rpx; }
.pv-h { font-size: 24rpx; margin-bottom: 16rpx; }
.btn-save { margin-top: 40rpx; text-align: center; background: #5f7060; color: #fff; border-radius: 14rpx; padding: 30rpx; font-size: 32rpx; font-weight: 600; }
.btn-save.disabled { opacity: .6; }
.latlng { display: flex; }
.ipt.half { width: 50%; box-sizing: border-box; height: 88rpx; min-height: 88rpx; padding: 0 24rpx; line-height: 88rpx; }
.ipt.half:first-child { margin-right: 16rpx; }
.map-pick { margin-top: 14rpx; text-align: center; color: #5f7060; background: #eef1ea; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; }

/* 节点类型多选标签 */
.type-tags { display: flex; flex-wrap: wrap; gap: 16rpx; }
.type-tag { padding: 14rpx 28rpx; border-radius: 30rpx; font-size: 27rpx; color: #6a6358; background: #f0ece4; border: 1rpx solid #e6ddcf; }
.type-tag.on { color: #fff; background: #5f7060; border-color: #5f7060; }

/* 邀请码 */
.invite-box { display: flex; align-items: center; justify-content: space-between; background: #fffdf8; border: 1rpx solid #e6ddcf; border-radius: 12rpx; padding: 22rpx 24rpx; }
.invite-code { font-size: 34rpx; font-weight: 700; letter-spacing: 4rpx; color: #9c5a3c; font-family: "Courier New", monospace; }
.invite-ops { display: flex; }
.invite-btn { font-size: 26rpx; color: #5f7060; padding: 8rpx 22rpx; border-radius: 8rpx; background: #eef1ea; margin-left: 14rpx; }
.invite-btn.gen { color: #fff; background: #5f7060; }

/* 背景音乐上传 */
.music-box { display: flex; align-items: center; justify-content: space-between; background: #fffdf8; border: 1rpx solid #e6ddcf; border-radius: 12rpx; padding: 22rpx 24rpx; }
.music-name { font-size: 27rpx; color: #6a6358; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.music-ops { display: flex; }
.music-btn { font-size: 26rpx; padding: 8rpx 22rpx; border-radius: 8rpx; margin-left: 14rpx; }
.music-btn.pick { color: #fff; background: #5f7060; }
.music-btn.del { color: #b06a55; background: #f4e9e5; }
.music-tip { font-size: 22rpx; margin-top: 12rpx; line-height: 1.6; }
