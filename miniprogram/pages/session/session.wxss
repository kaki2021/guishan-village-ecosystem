.title { font-size:46rpx; margin:16rpx 0 30rpx; }
.info { background:#fffdf8; border:1rpx solid #e6ddcf; border-radius:16rpx; padding:10rpx 28rpx; }
.line { padding:22rpx 0; border-bottom:1rpx solid #f0eadd; }
.line:last-child { border-bottom:none; }
.k { display:inline-block; width:100rpx; }
.desc { margin-top:30rpx; font-size:32rpx; line-height:1.9; }
.bar { position:fixed; left:0; right:0; bottom:0; padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background:#f5f1ea; border-top:1rpx solid #e6ddcf; }
.share-line { margin-top:40rpx; background:transparent; color:#5f7060; border:1rpx solid #b9c2b3; border-radius:12rpx; font-size:30rpx; padding:20rpx 0; }
.share-line::after { border:none; }
.s-cover { width:100%; display:block; }

/* 场次列表 */
.sec-h { font-size: 30rpx; font-weight: 600; color: #2f2f2b; margin: 36rpx 0 18rpx; }
.ses { display: flex; align-items: center; background: #fffdf8; border: 1rpx solid #e6ddcf; border-radius: 14rpx; padding: 24rpx 28rpx; margin-bottom: 16rpx; }
.ses-l { flex: 1; }
.ses-d { font-size: 29rpx; color: #2f2f2b; }
.ses-r { font-size: 24rpx; margin-top: 6rpx; }
.ses-btn { padding: 14rpx 30rpx; border-radius: 10rpx; font-size: 27rpx; color: #fff; background: #9c5a3c; }
.ses-btn.ghost { color: #5f7060; background: transparent; border: 1rpx solid #c2cbbb; }
.ses-btn.disabled { color: #b8b0a2; background: #f0ece4; }
.empty2 { text-align: center; padding: 40rpx 0; }
