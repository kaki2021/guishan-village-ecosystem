.cert { background:#5f7060; color:#fdfdfa; border-radius:18rpx; padding:46rpx 36rpx; margin-top:20rpx; box-shadow:0 6rpx 24rpx rgba(0,0,0,.1); box-sizing:border-box; }
.cert-cn { font-size:24rpx; letter-spacing:4rpx; color:#dde4d9; }
.cert-sub { color:#dde4d9 !important; margin-top:14rpx; }
.vcard { background:#fffdf8; border:1rpx solid #e6ddcf; border-radius:14rpx; padding:28rpx; margin-top:24rpx; }
.v-head { display:flex; justify-content:space-between; align-items:baseline; }
.v-name { font-size:36rpx; }
.v-title { font-size:32rpx; }
.stamps { display:flex; flex-wrap:wrap; margin-top:18rpx; }
.stamp { background:#eaeee6; color:#5f7060; border-radius:24rpx; padding:10rpx 24rpx; margin:0 16rpx 14rpx 0; font-size:26rpx; }
.link { color:#5f7060; padding:30rpx 0; }
.admin-link { margin-top:40rpx; padding:26rpx; text-align:center; color:#5f7060; border:1rpx dashed #b9c2b3; border-radius:12rpx; }
.roles { margin-top:24rpx; display:flex; flex-wrap:wrap; }
.role { font-size:24rpx; color:#fdfdfa; border:1rpx solid #9fb097; border-radius:24rpx; padding:8rpx 22rpx; margin:0 14rpx 12rpx 0; }
.me-row { display:flex; align-items:center; margin-top:24rpx; }
.me-av { width:88rpx; height:88rpx; border-radius:50%; margin-right:20rpx; }
.me-av.ph { background:#7e8c78; color:#fdfdfa; text-align:center; line-height:88rpx; font-size:36rpx; }
.me-name { font-size:38rpx; color:#fdfdfa; flex:1; }
.me-edit { font-size:24rpx; color:#dde4d9; }
.ws-box { background:#fffdf8; border:1rpx solid #e6ddcf; border-radius:14rpx; padding:24rpx; margin-top:24rpx; }
.ws-h { font-size:24rpx; letter-spacing:3rpx; margin-bottom:16rpx; }
.ws-row { display:flex; flex-wrap:wrap; }
.ws { font-size:28rpx; background:#eaeee6; color:#5f7060; border-radius:24rpx; padding:10rpx 24rpx; margin:0 16rpx 14rpx 0; }
.rank { font-size:22rpx; color:#9c5a3c; background:#f1e6da; border-radius:20rpx; padding:4rpx 16rpx; margin-left:16rpx; vertical-align:middle; }



/* 风吹岭旅人编号 —— 暗金描边款，沉静配绿 */
.fcl { margin-top: 28rpx; padding: 22rpx 26rpx; border: 1rpx solid rgba(201,162,94,.55); border-radius: 12rpx; background: rgba(0,0,0,.12); }
.fcl-top { display: flex; align-items: center; justify-content: space-between; }
.fcl-seq { font-size: 26rpx; color: #e3c894; font-weight: 600; letter-spacing: 1rpx; }
.fcl-no { font-size: 27rpx; color: #d8bd8a; letter-spacing: 3rpx; font-family: "Courier New", monospace; }
.fcl-date { margin-top: 12rpx; font-size: 22rpx; color: #b9c2b2; letter-spacing: 1rpx; }

/* 邀请码加入入口 */
.invite-enter { margin-top: 26rpx; text-align: center; font-size: 26rpx; color: #e3c894; border: 1rpx dashed rgba(201,162,94,.5); border-radius: 12rpx; padding: 22rpx; }
