.container { padding: 28rpx 32rpx 100rpx; }
.muted { color: #8a8378; }
.ppick { background: #fffdf8; border: 1rpx solid #e6ddcf; border-radius: 12rpx; padding: 26rpx; font-size: 30rpx; color: #8a8378; }
.pp-name { color: #2f2f2b; font-weight: 600; }
.grp { font-size: 28rpx; font-weight: 600; color: #41523f; margin: 42rpx 0 18rpx; }
.f { margin-bottom: 24rpx; }
.lb { font-size: 25rpx; color: #8a8378; margin-bottom: 14rpx; }
.ipt, .ta { background: #fffdf8; border: 1rpx solid #e6ddcf; border-radius: 12rpx; padding: 22rpx 24rpx; font-size: 30rpx; line-height: 1.6; width: 100%; box-sizing: border-box; }
.ipt { min-height: 50rpx; }
.ta { min-height: 96rpx; }
.ta.html { min-height: 460rpx; font-family: "Courier New", monospace; font-size: 26rpx; line-height: 1.65; }
.hint { font-size: 24rpx; line-height: 1.75; color: #8a7c63; background: #f6efe6; border-radius: 12rpx; padding: 24rpx; margin-bottom: 18rpx; }
.hl { color: #9c5a3c; }
.row { display: flex; margin-top: 18rpx; }
.mini-btn { flex: 1; text-align: center; color: #5f7060; background: #eef1ea; border-radius: 12rpx; padding: 22rpx; font-size: 28rpx; margin-right: 16rpx; }
.mini-btn:last-child { margin-right: 0; }
.preview { margin-top: 28rpx; background: #fffdf8; border: 1rpx solid #e6ddcf; border-radius: 14rpx; padding: 28rpx; }
.pv-h { font-size: 24rpx; margin-bottom: 16rpx; }
.btn-save { margin-top: 40rpx; text-align: center; background: #5f7060; color: #fff; border-radius: 14rpx; padding: 30rpx; font-size: 32rpx; font-weight: 600; }
.btn-save.disabled { opacity: .6; }
.prow { display: flex; align-items: stretch; margin-top: 14rpx; }
.pr-btn { flex: 1; text-align: center; color: #5f7060; background: #eef1ea; border-radius: 12rpx; padding: 20rpx; font-size: 27rpx; margin-right: 16rpx; }
.pr-btn:last-child { margin-right: 0; }
.pr-btn.del { color: #b06a55; background: #f4e9e5; }

.pr-move { width: 72rpx; flex-shrink: 0; text-align: center; color: #5f7060; background: #eef1ea; border-radius: 12rpx; padding: 20rpx 0; font-size: 24rpx; margin-left: 12rpx; }
