.page { width: 100%; height: 100vh; position: relative; }
.map { width: 100%; height: 100vh; }
.empty { padding: 120rpx 60rpx; text-align: center; color: #8a8378; font-size: 28rpx; line-height: 1.8; }
.card { position: absolute; left: 24rpx; right: 24rpx; bottom: 40rpx; background: #fffdf8; border-radius: 18rpx; padding: 32rpx; box-shadow: 0 8rpx 30rpx rgba(0,0,0,.18); }
.c-close { position: absolute; top: 16rpx; right: 24rpx; font-size: 44rpx; color: #b8b0a2; line-height: 1; }
.c-name { font-size: 36rpx; font-weight: 600; color: #2f2f2b; }
.c-intro { font-size: 27rpx; color: #6a6358; line-height: 1.6; margin-top: 12rpx; }
.c-acts { display: flex; margin-top: 24rpx; }
.c-btn { flex: 1; text-align: center; border-radius: 12rpx; padding: 24rpx; font-size: 29rpx; }
.c-btn.ghost { color: #5f7060; border: 1rpx solid #c2cbbb; margin-right: 16rpx; }
.c-btn.fill { color: #fff; background: #9c5a3c; }
