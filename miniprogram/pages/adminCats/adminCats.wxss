.op.ok { color: #3f7a4f; }
.op.del { color: #b06a55; }
.add { text-align: center; color: #5f7060; border: 1rpx dashed #b9c2b3; border-radius: 12rpx; padding: 22rpx; font-size: 28rpx; margin-top: 4rpx; }
