.grp-gap { margin-top: 46rpx; }
.gh-s { font-size: 24rpx; font-weight: normal; }
.pend-h { font-size: 24rpx; margin: 6rpx 0 12rpx; }
.cat { display: flex; align-items: center; background: #fffdf8; border: 1rpx solid #e6ddcf; border-radius: 12rpx; padding: 22rpx; margin-bottom: 14rpx; }
.cat.pend { border-color: #d8a878; background: #fff7ee; }
.c-l { font-size: 32rpx; flex: 1; }
.ops { display: flex; }
